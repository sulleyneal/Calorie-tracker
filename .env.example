# Gemini API key — parses free-text meals ("had a latte and a bagel").
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key — a FREE, fast fallback brain for smart meal parsing (no
# credit card, generous limits). Used automatically when Gemini's free tier
# is congested. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# USDA FoodData Central API key — accurate calories & macros.
# Get one free at https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works for light use.
USDA_API_KEY=DEMO_KEY

# Optional passphrase. When set, the app asks for it once before using this
# server's keys — so a public deployment doesn't let strangers spend your
# Gemini quota.
ACCESS_CODE=

# Food images are illustrated plates by default. Set ENABLE_IMAGES=true to
# generate real AI food photos instead (requires Gemini billing enabled).
ENABLE_IMAGES=

# Port for the web server
PORT=3000
